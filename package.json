{
  "name": "largevcmodel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://largevcmodel:largevcmodel@localhost:5432/largevcmodel} next dev",
    "build": "DATABASE_URL=${DATABASE_URL:-postgresql://largevcmodel:largevcmodel@localhost:5432/largevcmodel} npm run db:generate && DATABASE_URL=${DATABASE_URL:-postgresql://largevcmodel:largevcmodel@localhost:5432/largevcmodel} next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://largevcmodel:largevcmodel@localhost:5432/largevcmodel} prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm install && npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@xyflow/react": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
