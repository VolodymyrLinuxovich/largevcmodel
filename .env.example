DATABASE_URL="postgresql://largevcmodel:largevcmodel@localhost:5432/largevcmodel"

# Required for signed cookies. Use at least 32 random bytes.
SESSION_SECRET="replace-with-random-session-secret"

# Required for encrypting OAuth tokens at rest. Base64, hex, or a long random string are accepted.
TOKEN_ENCRYPTION_KEY="replace-with-random-token-encryption-key"

# Public app URL used to build OAuth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 web client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Research provider. Use "none" until Hermes or another provider is connected.
RESEARCH_PROVIDER="none"
HERMES_API_URL=""
HERMES_API_KEY=""
HERMES_COMMAND="hermes"
